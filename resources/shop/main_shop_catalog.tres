[gd_resource type="Resource" script_class="ShopCatalog" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/shop/ShopCatalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/shop/ShopData.gd" id="2_shopdata"]
[ext_resource type="Resource" path="res://resources/items/damage_amp.tres" id="3_damage_amp"]
[ext_resource type="Resource" path="res://resources/items/dash_core.tres" id="4_dash_core"]
[ext_resource type="Resource" path="res://resources/items/repair_cell.tres" id="5_repair_cell"]

[sub_resource type="Resource" id="ShopData_1"]
script = ExtResource("2_shopdata")
shop_item_id = &"shop_neon_edge"
item_data = ExtResource("3_damage_amp")
price = 150
stock = -1

[sub_resource type="Resource" id="ShopData_2"]
script = ExtResource("2_shopdata")
shop_item_id = &"shop_dash_core"
item_data = ExtResource("4_dash_core")
price = 120
stock = 3

[sub_resource type="Resource" id="ShopData_3"]
script = ExtResource("2_shopdata")
shop_item_id = &"shop_repair_cell"
item_data = ExtResource("5_repair_cell")
price = 80
stock = -1

[resource]
script = ExtResource("1_catalog")
catalog_name = "Supply Station"
items = [SubResource("ShopData_1"), SubResource("ShopData_2"), SubResource("ShopData_3")]
